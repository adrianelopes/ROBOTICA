<?xml version="1.0" ?>
<!--
  Mundo para testar os sensores: chão, sol e alguns obstáculos coloridos à frente do robô
  (a câmera e o lidar precisam ter o que enxergar).
  O <spherical_coordinates> é obrigatório para o GPS: define a latitude/longitude da origem do mundo.
  Mantenha a origem igual à de config/sensores.yaml (origem_lat, origem_lon, origem_alt).
  heading_deg = 180 por causa de um bug do Gazebo Classic: com heading 0 ele trata o mundo como
  oeste-sul-cima (X e Y invertidos no GPS). Com 180, X fica para o leste e Y para o norte (ENU).
-->
<sdf version="1.6">
  <world name="sensores_world">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>-7.1396</latitude_deg>
      <longitude_deg>-34.8450</longitude_deg>
      <elevation>5.0</elevation>
      <heading_deg>180</heading_deg>
    </spherical_coordinates>

    <model name="caixa_vermelha">
      <static>true</static>
      <pose>2.0 0.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="cilindro_verde">
      <static>true</static>
      <pose>3.5 1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Green</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="parede_azul">
      <static>true</static>
      <pose>5.5 -1.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 4.0 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 4.0 0.8</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="caixa_amarela">
      <static>true</static>
      <pose>3.0 -1.8 0.2 0 0 0.6</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.3 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.3 0.4</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Yellow</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
